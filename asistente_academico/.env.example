# Copiar este archivo como .env y ajustar si hace falta

# Dirección donde corre Ollama
OLLAMA_API_BASE=http://localhost:11434

# Modelo a usar con LiteLLM (formato: ollama_chat/<nombre_del_modelo>)
# Modelo local y gratuito (se baja con `ollama pull qwen3:8b`):
MODELO_AGENTE=ollama_chat/qwen3:8b
# Alternativa en la nube de Ollama (requiere `ollama signin` y puede requerir créditos):
# MODELO_AGENTE=ollama_chat/gemma4:31b-cloud
